{{ define "admin" }}{{ template "header" . }}

      <div class="gk-kpirow" id="adminStats">
        <div class="gk-kpi">
          <span class="gk-kpi__k">Fichiers en ligne</span>
          <span class="gk-kpi__v" id="statFileCount">{{ .StatFileCount }}</span>
        </div>
        <div class="gk-kpi">
          <span class="gk-kpi__k">Espace utilisé</span>
          <span class="gk-kpi__v" id="statStorageUsed">{{ .StatStorageUsed }}</span>
        </div>
        <div class="gk-kpi">
          <span class="gk-kpi__k">Téléchargements</span>
          <span class="gk-kpi__v" id="statDownloadCount">{{ .StatDownloadCount }}</span>
        </div>
        <div class="gk-kpi">
          <span class="gk-kpi__k">Expirent sous 24 h</span>
          <span class="gk-kpi__v" id="statExpiringSoon">{{ .StatExpiringSoon }}</span>
        </div>
      </div>

      <div class="row">
        <div class="col">
		<div id="container" class="card" style="width: 92%">
		  <div class="card-body">
		    <h3 class="card-title">Envoi</h3>
		    <br>
		    <p class="card-text">
		    
			<form action="./uploadChunk" class="dropzone upload-box text-center w-100" id="uploaddropzone">
				<div class="dz-message">
{{ if .EndToEndEncryption }}
				    <p id="uploadBoxTitle" class="mb-2 fs-5">Veuillez patienter</p>
				    <p id="uploadBoxSubtitle" class="mb-0 opacity-75">Chargement du chiffrement de bout en bout...</p>
{{ else }}
				    <p id="uploadBoxTitle" class="mb-2 fs-5">Glissez-déposez vos fichiers ici</p>
				    <p id="uploadBoxSubtitle" class="mb-0 opacity-75">ou collez, ou cliquez pour choisir.</p>
{{ end }}
				</div>
			</form>
		
		<div id="uploadstatus" class="container uploads-container">
		</div>		
		<p></p>
		
		<br>
		<table class="table gk-settings" id="uploadOptions">
		  <tbody>

		    <tr>
		      <td class="gk-settings__label">
		        <i class="bi bi-arrow-down-circle upload-option-icon"></i><label for="allowedDownloads">Limite de téléchargements</label>
		      </td>
		      <td class="gk-settings__toggle">
		        <div class="form-check form-switch mb-0 d-inline-block">
		          <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		                 name="enableDownloadLimit" id="enableDownloadLimit"
		                 onchange="checkBoxChanged(this, 'allowedDownloads')" checked
		                 aria-label="Activer la limite de téléchargements">
		        </div>
		      </td>
		      <td class="gk-settings__value">
		        <div class="input-group">
		          <input type="number" class="form-control admin-input" value="1"
		                 name="allowedDownloads" id="allowedDownloads" min="1"
		                 style="text-align: right;" data-allow-regular-paste>
		          <span class="input-group-text upload-option-suffix">Téléchargements</span>
		        </div>
		      </td>
		    </tr>

		    <tr>
		      <td class="gk-settings__label">
		        <i class="bi bi-calendar-x upload-option-icon"></i><label for="expiryDays">Expiration</label>
		      </td>
		      <td class="gk-settings__toggle">
		        <div class="form-check form-switch mb-0 d-inline-block">
		          <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		                 name="enableTimeLimit" id="enableTimeLimit"
		                 onchange="checkBoxChanged(this, 'expiryDays')" checked
		                 aria-label="Activer la limite de durée">
		        </div>
		      </td>
		      <td class="gk-settings__value">
		        <div class="input-group">
		          <input type="number" class="form-control admin-input" value="14"
		                 name="expiryDays" id="expiryDays" min="1" max="100000"
		                 style="text-align: right;" data-allow-regular-paste>
		          <span class="input-group-text upload-option-suffix">Jours</span>
		        </div>
		      </td>
		    </tr>

		    <tr>
		      <td class="gk-settings__label">
		        <i class="bi bi-key upload-option-icon"></i><label for="password">Mot de passe</label>
		      </td>
		      <td class="gk-settings__toggle">
		        <div class="form-check form-switch mb-0 d-inline-block">
		          <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		                 name="enablePassword" id="enablePassword"
		                 onchange="checkBoxChanged(this, 'password')"
		                 aria-label="Activer la protection par mot de passe">
		        </div>
		      </td>
		      <td class="gk-settings__value">
		        <input class="form-control admin-input" value=""
		               name="password" id="password" placeholder="Aucun mot de passe" disabled
		               data-allow-regular-paste>
		      </td>
		    </tr>

		  </tbody>
		</table>
<div id="errordiv" class="alert alert-danger" style="display:none">
  <span id="errormessage" ></span>
</div>
		<br><br>
		<div class="table-responsive">
			<table id="maintable" class="table table-dark">
				<thead>
					<tr>
						<th scope="col" style="text-align: center;">Nom du fichier</th>
						<th scope="col" style="text-align: center;">Taille</th>
						<th scope="col" style="text-align: center;">Téléch. restants</th>
						<th scope="col" style="text-align: center;">Expire le</th>
						<th scope="col" style="text-align: center;">Téléchargements</th>
						<th scope="col" style="text-align: center;">ID</th>
						<th scope="col" style="text-align: center; white-space: nowrap;">État</th>
						<th scope="col" style="text-align: center; min-width:15em;">Actions</th>
					</tr>
				</thead>
				<tbody id="downloadtable">
{{ range .Items }}
	{{ if not (or .IsPendingDeletion .IsFileRequest) }}	
		{{ if  or (gt .ExpireAt $.TimeNow) (.UnlimitedTime) }}
			{{ if or (gt .DownloadsRemaining 0) (.UnlimitedDownloads) }}
					<tr id="row-{{ .Id }}" data-expire="{{ if .UnlimitedTime }}0{{ else }}{{ .ExpireAt }}{{ end }}" data-remaining="{{ if .UnlimitedDownloads }}-1{{ else }}{{ .DownloadsRemaining }}{{ end }}">
						<td id="cell-name-{{ .Id }}">{{ .Name }}</td>
						<td data-order="{{ .SizeBytes }}">{{ .Size }}</td>
				{{ if .UnlimitedDownloads }}
						<td>Illimité</td>
				{{ else }}
						<td id="cell-downloadsRemaining-{{ .Id }}">{{ .DownloadsRemaining }}</td>
				{{ end }}
				{{ if .UnlimitedTime }}
						<td>Illimité</td>
				{{ else }}
						<td><span id="cell-expireatstring-{{ .Id }}"></span></td>
						 <script>insertFormattedDate({{ .ExpireAt }}, "cell-expireatstring-{{ .Id }}");</script>
				{{ end }}
						<td id="cell-downloads-{{ .Id }}">{{ .DownloadCount }}</td>
						<td><a id="url-href-{{ .Id }}" target="_blank" href="{{ .UrlDownload }}">{{ .Id }}</a>{{ if .IsPasswordProtected }}  <i title="Protégé par mot de passe" class="bi bi-key"></i>{{ end }}</td>
						<td id="cell-status-{{ .Id }}">{{ with $.FileStatus . }}<span class="badge {{ .Class }}"><span class="gk-dot"></span>{{ .Label }}</span>{{ end }}</td>
						<td>
						<div class="btn-toolbar justify-content-end" role="toolbar" >
						  <div class="btn-group me-2" role="group">
						     {{ template "admin_button_copyurl" (newAdminButtonContext . $.ActiveUser)}}
						     {{ template "admin_button_share" (newAdminButtonContext . $.ActiveUser)}}
						  </div>
						  <div class="btn-group" role="group">
						     {{ template "admin_button_download" (newAdminButtonContext . $.ActiveUser) }}
						     {{ template "admin_button_edit" (newAdminButtonContext . $.ActiveUser) }}
						     {{ template "admin_button_delete" (newAdminButtonContext . $.ActiveUser) }}
						 </div>
						</div></td>
					</tr>
			{{ end }}
		{{ end }}
	{{ end }}
{{ end }}
				</tbody>
			</table>
		      </div>
		  </div>
		</div>
	    </div>
   	 </div>
	
	{{ template "admin_modal_edit" }}
	

	<div id="toastnotification" class="toastnotification" data-default="URL copied to clipboard">Toast Text</div>
	<div id="toastnotificationUndo" class="toastnotification">
	  Fichier supprimé : <span id="toastFilename"></span>
  	   <span id="toastUndoButton" class="toast-undo" onclick="handleUndo(this)">Restaurer</span>
	</div>
	<div id="toastDeprecation" class="toastnotification toastdeprecation">
	  Attention : ce serveur utilise une fonction obsolète. Les détails sont dans les journaux système.
	</div>
	<div id="qroverlay">
	  <div id="qrcode"></div>
	</div>

	<script src="./assets/dist/js/jszip.min.js"></script>
	<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
	<script>
	
	initDropzone();
	initZipUpload();
	initAdminStats();

	Dropzone.options.uploaddropzone["maxFilesize"] = {{ .MaxFileSize }};
	Dropzone.options.uploaddropzone["timeout"] = 1200000;
	Dropzone.options.uploaddropzone["chunking"] = true;
	Dropzone.options.uploaddropzone["chunkSize"] = {{ .ChunkSize }} * 1024 * 1024;
	Dropzone.options.uploaddropzone["parallelUploads"] = 1;
	Dropzone.options.uploaddropzone["parallelChunkUploads"] = {{.MaxParallelUploads}};
	Dropzone.options.uploaddropzone["forceChunking"] = true;
	Dropzone.options.uploaddropzone["retryChunksLimit"] = 3;
	Dropzone.options.uploaddropzone["retryChunks"] = true;
	Dropzone.options.uploaddropzone["previewsContainer"] = false;
	
	$(document).ready(function () {
	
	    $('#maintable').DataTable({
	    "responsive": true,
	    "order": [], // disables initial sorting
	    "columnDefs": [ {
		"targets": 7,
		"orderable": false
		} ],
	    "paging": false,
	    "language": {
	      "info": "Fichiers stockés : _TOTAL_",
	      "emptyTable": "Aucun fichier pour l'instant",
	      "infoEmpty": "",
	      "search": "Filtrer :",
	      "searchPlaceholder": "nom ou identifiant",
	      "zeroRecords": "Aucun fichier ne correspond",
	    }
	    });
	});
	
	registerChangeHandler();
		
	var canReplaceOwnFiles = {{.ActiveUser.HasPermissionReplace}};
	setUploadDefaults();
	
{{ if .ShowDeprecationNotice }}
	showDeprecationNotice();
{{ end }}
	
	</script>
        <script src="./js/min/uuid.min.js"></script>

{{ if .EndToEndEncryption }}
        <script src="./js/min/wasm_exec.min.js"></script>
	<script src="./js/min/end2end_admin.min.{{ template "js_e2eversion"}}.js"></script>
	<script>
	{{ if .IncludeFilename }} 
		const IncludeFilename = true;
	{{ else }}
		const IncludeFilename = false;
	{{ end }}
		isE2EEnabled = true;
	
		Blob.prototype.arrayBuffer ??= function() {
		    return new Response(this).arrayBuffer()
		}
		
		checkIfE2EKeyIsSet();
	</script>
{{ end }}
        
        
{{ template "pagename" "FileRequest"}}
{{ template "customjs" .}}


{{ template "footer" true}}
{{ end }}



{{ define "admin_button_download" }}
			<button
			    type="button"
			    title="Télécharger"
			    class="btn btn-outline-light btn-sm {{if .CurrentFile.RequiresClientSideDecryption}}disabled{{end}}"
			    onclick="downloadFileWithPresign('{{.CurrentFile.Id }}');">
		   	    <i class="bi bi-download"></i>
			</button>

{{ end }}

{{ define "admin_button_edit" }}
			<button
			    type="button"
			    title="Modifier"
			    {{ if and (ne .ActiveUser.Id .CurrentFile.UploaderId) (not .ActiveUser.HasPermissionEditOtherUploads) }}
			    	disabled
			    {{ end }}
			    class="btn btn-outline-light btn-sm"
			    onclick="showEditModal('{{.CurrentFile.Name }}',
			    	'{{.CurrentFile.Id}}', {{.CurrentFile.DownloadsRemaining }},
			    	 {{.CurrentFile.ExpireAt }}, {{.CurrentFile.IsPasswordProtected}},
			    	 {{.CurrentFile.UnlimitedDownloads }}, {{.CurrentFile.UnlimitedTime}},
			    	 {{.CurrentFile.IsEndToEndEncrypted}},
			    	 {{ or (and (eq .ActiveUser.Id .CurrentFile.UploaderId) (.ActiveUser.HasPermissionReplace))
			    	 	(.ActiveUser.HasPermissionReplaceOtherUploads) }});">
		   	    <i class="bi bi-pencil"></i>
			</button>

{{ end }}


{{ define "admin_button_delete" }}
			<button id="button-delete-{{ .CurrentFile.Id}}"
			   type="button"
			   title="Supprimer"
			    {{ if and (ne .ActiveUser.Id .CurrentFile.UploaderId) (not .ActiveUser.HasPermissionDeleteOtherUploads) }}
			    	disabled
			    {{ end }}
			   class="btn btn-outline-danger btn-sm"
			   onclick="deleteFile('{{ .CurrentFile.Id }}')">
			   <i class="bi bi-trash3"></i>
			</button>
{{ end }}

{{ define "admin_button_copyurl" }}
		    <button id="url-button-{{ .CurrentFile.Id }}" type="button" onclick="showToast(1000)"
		    	data-clipboard-text="{{ .CurrentFile.UrlDownload }}" class="copyurl btn btn-outline-light btn-sm" title="Copier le lien"><i class="bi bi-copy"></i> URL</button>
		    <button type="button" class="btn btn-outline-light btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
		    </button>
			<ul class="dropdown-menu dropdown-menu-end" data-bs-theme="dark" >
	{{ if ne .CurrentFile.UrlHotlink "" }}
			    <li style="cursor: pointer;"><a class="dropdown-item copyurl" title="Copier le lien direct" onclick="showToast(1000)"
			    	data-clipboard-text="{{ .CurrentFile.UrlHotlink }}"><i class="bi bi-copy"></i> Lien direct</a></li>
		{{ else }}
			    <li><a class="dropdown-item disabled">Lien direct indisponible</a></li>
	{{ end }}
			</ul>
{{ end }}

{{ define "admin_button_share" }}
		    <button type="button" class="btn btn-outline-light btn-sm" title="Partager" onclick="shareUrl(event, '{{ .CurrentFile.Id }}',
		       '{{ .CurrentFile.UrlDownload }}')">
		       <!-- For some reason bi-share does not always show up, using the svg fixes it -->
		       	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi" viewBox="0 0 16 16">
 				 <path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.5 2.5 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5m-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/>
			</svg>
</button>
		    <button type="button" id="shareDropdown-{{ .CurrentFile.Id }}" class="btn btn-outline-light btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
		    </button>
			<ul class="dropdown-menu dropdown-menu-end" data-bs-theme="dark" >
			    <li style="cursor: pointer;"><a class="dropdown-item" id="qrcode-{{ .CurrentFile.Id }}" title="Afficher le QR code" onclick="showQrCode('{{ .CurrentFile.UrlDownload }}');"><i class="bi bi-qr-code"></i> QR code</a></li>
			    <li style="cursor: pointer;"><a class="dropdown-item" id="email-{{ .CurrentFile.Id }}" href="mailto:?body={{ .CurrentFile.UrlDownload | urlquery}}"
			       target="_blank" title="Envoyer par courriel"><i class="bi bi-envelope"></i> Courriel</a></li>
			</ul>
{{ end }}

{{ define "admin_modal_edit" }}

	<div class="modal fade" id="modaledit" tabindex="-1" aria-labelledby="m_filenamelabel" aria-hidden="true">
	  <div class="modal-dialog  modal-lg gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
		<h1 class="modal-title fs-5" id="m_filenamelabel">Nom du fichier</h1>
	      </div>
	      <div class="modal-body">
		<div class="input-group mb-3">
		  <div class="input-group-text">
      			<input type="checkbox" id="mc_download"  checked aria-label="Limiter les téléchargements" title="Limiter les téléchargements"  data-toggle-target="mi_edit_down" onchange="handleEditCheckboxChange(this)">
   		 </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_down">Limiter les téléchargements</span>
		  <input type="number" min="1" id="mi_edit_down" class="form-control" aria-label="Téléch. restants" aria-describedby="edit_down" data-allow-regular-paste>
		</div>
		<div class="input-group mb-3">
		  <div class="input-group-text">
      			<input id="mc_expiry" type="checkbox" checked aria-label="Faire expirer des fichiers" title="Faire expirer des fichiers"  data-toggle-target="mi_edit_expiry" data-timestamp="" onchange="handleEditCheckboxChange(this)" >
   		 </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_expdate">Expiration</span>
		  <input type="text" id="mi_edit_expiry" class="form-control" aria-label="Expiration" aria-describedby="edit_expdate"  data-allow-regular-paste>
		</div>
		<div class="input-group mb-3">
		  <div class="input-group-text">
      			<input type="checkbox" id="mc_password" aria-label="Exiger un mot de passe" title="Exiger un mot de passe" data-toggle-target="mi_edit_pw" onchange="handleEditCheckboxChange(this)">
   		 </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_pw">Mot de passe</span>
		  <input type="text" id="mi_edit_pw" class="form-control" aria-label="Mot de passe" disabled onclick="selectTextForPw(this)" aria-describedby="edit_pw"  data-allow-regular-paste>
		</div>
		
	      <div class="input-group mb-3" id="replaceGroup">
		  <div class="input-group-text">
		    <input type="checkbox" id="mc_replace" aria-label="Remplacer le contenu du fichier" title="Remplacer le contenu du fichier" data-toggle-target="mi_edit_replace" onchange="handleEditCheckboxChange(this)">
		  </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_replace">Remplacer le contenu</span>
		  <select id="mi_edit_replace" class="form-select" aria-label="Remplacer le contenu du fichier" disabled>
		  </select>
		</div>
	      </div>
	      <div class="modal-footer">
		<button type="button" class="btn btn-outline-light"  aria-label="Fermer" data-bs-dismiss="modal">Fermer</button>
		<button type="button" class="btn btn-primary" data-fileid="" id="mb_save" onclick="editFile();">Enregistrer les modifications</button>
	      </div>
	    </div>
	  </div>
	</div>

{{ end }}
