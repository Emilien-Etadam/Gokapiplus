{{define "login"}}{{ template "header" . }} 
      <div class="row">
        <div class="col">
		<div id="container" class="card" style="width: 20em">
		  <div class="card-body">
		    <h1 class="card-title">Connexion</h1>
		    <br>
		    <p class="card-text">
			<form method="post" action="./login" id="form" name="form" onSubmit="submitForm()">
			    <div class="mb-3">
				<input type="text" class="form-control mx-auto" style="max-width: 300px;" 
				       autocomplete="username" placeholder="Nom d'utilisateur" value="{{.User}}" id="username">
				<input type="hidden" id="uname_hidden" name="username">
			    </div>

			    <div class="mb-3">
				<input type="password" class="form-control mx-auto" style="max-width: 300px;" 
				       autocomplete="current-password" placeholder="Mot de passe" id="password">
				<input type="hidden" id="pw_hidden" name="password">
			    </div>

{{ if .IsFailedLogin }}
	{{ if .IsFailedCsfr }}
			    <div class="mb-3">
				<span class="text-danger">La page de connexion est restée ouverte trop longtemps et a expiré. Réessayez.</span>
			    </div>
	{{ else }}
			    <div class="mb-3">
				<span class="text-danger">Nom d'utilisateur ou mot de passe incorrect !</span>
			    </div>
	{{ end }}
{{ end }}

			    <div class="mt-4">
				<button type="submit" id="submitbutton" class="btn btn-primary w-100 mx-auto" style="max-width: 300px;">
				    Connexion
				</button>
			    </div>
				<input type="hidden" id="csrf-token" name="csrf-token" value="{{.CsrfToken}}">
			</form>
			<br><br>
			<a href="./forgotpw">Mot de passe oublié</a></p>
		  </div>
		</div>
	    </div>
   	 </div>
<script>
function submitForm(){
	document.getElementById("username").disabled = true;
	document.getElementById("password").disabled = true;
	document.getElementById("uname_hidden").value = document.getElementById("username").value;
	document.getElementById("pw_hidden").value = document.getElementById("password").value;
	document.getElementById("submitbutton").disabled = true;
	return true;
}
</script>
{{ template "pagename" "Login"}}
{{ template "customjs" .}}
{{ template "footer" }}
{{end}}
